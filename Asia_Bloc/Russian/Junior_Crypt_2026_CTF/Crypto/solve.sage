from sage.all import *

n = 

e = 3

c1 = 

c2 = 

a = 1337
b = 5577100914618608347433571795909361526455637706263378490

R.<x> = PolynomialRing(Zmod(n))

f = x^3 - c1
g = (a*x + b)^3 - c2

h = f.gcd(g)

m = int(-h[0])

print("m =", m)

